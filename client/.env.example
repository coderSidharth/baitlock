# Public base URL of the Baitlock API (FastAPI), used by the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: backend URL used by the Next.js server for /api/v1 rewrites
# (e.g. an internal Docker/K8s service name). Defaults to NEXT_PUBLIC_API_URL.
# BACKEND_INTERNAL_URL=http://backend:8000
