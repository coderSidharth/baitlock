{
    "manifest_version": 3,
    "name": "Baitlock Phishing Shield",
    "version": "1.0",
    "description": "Enterprise-grade real-time phishing and fraud detection for your browser.",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "action": {
        "default_popup": "popup/popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content_script.js"
            ]
        }
    ]
}