# LLM Configuration
# Set LLM_PROVIDER to either "ollama" or "groq"
LLM_PROVIDER=ollama

# Ollama Settings
OLLAMA_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_CHAT_URL=http://localhost:11434/api/chat

# Groq Settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Deployment mode. "production" enforces a strong SECRET_KEY and safe CORS at startup.
ENVIRONMENT=development

# Comma-separated web origins allowed to call the API (your dashboard URL in production).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Secret Key — generate a strong random key and keep it stable!
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# Database URL (use absolute path for SQLite to avoid cwd issues).
# PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=sqlite:///./events.db

# Failed-login protection: max failed attempts per (IP, email) per window.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900

# Token/session policy (sign in again after expiry; no persistent refresh token).
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_SESSIONS_PER_USER=10

# Maximum simultaneous LLM network calls per worker; excess calls degrade immediately.
LLM_MAX_CONCURRENT=4
LLM_TIMEOUT_SECONDS=8

# Synthetic fraud scoring is demo-only. Always disabled in production.
ENABLE_DEMO_FRAUD_MODEL=false

# Required for production model loading. Use a separate strong secret, then sign
# the trusted artifact before deployment:
# uv run python -m app.features.phishing.phishing_ml --sign
MODEL_HMAC_KEY=
